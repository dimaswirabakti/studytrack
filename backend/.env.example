# port server backend
PORT=4000

# connection string postgres dari neon branch dev
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# kunci penandatangan jwt minimal 32 karakter, buat dengan perintah openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# api key dari google ai studio, kosongkan untuk menonaktifkan fitur rencana ai
GEMINI_API_KEY=

# model gemini yang dipakai untuk menyusun rencana kerja
GEMINI_MODEL=gemini-3.1-flash-lite
